# Copy to .env.local for local dev, or set these in the Vercel dashboard.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Base URL of the self-hosted backend, with no trailing slash.
#
# Leave it BLANK to talk to the API on the same origin -- correct when you put
# the frontend and backend behind one tunnel or reverse proxy.
#
# Set it when the frontend is on Vercel and the API is on your homelab box:
#   VITE_API_BASE_URL=https://bears.example.com
VITE_API_BASE_URL=
