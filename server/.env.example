# Copy to .env and edit. `npm start` loads this file automatically (and Docker
# Compose reads it for variable substitution). Every value below is read at
# startup.

# Port the API listens on.
PORT=8080
HOST=0.0.0.0

# REQUIRED. The host types this into /admin to unlock round controls.
# The server refuses to boot without it. Minimum 6 characters.
ADMIN_TOKEN=change-me-before-the-party

# OPTIONAL. If set, guests must type this password before they can join.
# Leave blank so anyone with the link (or QR code) can walk in.
PARTY_PIN=

# Where the SQLite file lives. Put it on a mounted volume so a container
# restart does not lose mid-party votes.
DATABASE_PATH=./data/bears.sqlite

# Comma-separated list of allowed browser origins, or * for any.
# Set this to your Vercel URL in production, e.g.
#   CORS_ORIGINS=https://fat-bear-week.vercel.app,http://localhost:5173
CORS_ORIGINS=*

# OPTIONAL. Set to 1 only when a reverse proxy or tunnel you control sits in
# front of the API. It makes Express trust X-Forwarded-For for rate limiting --
# which, with no real proxy in front, lets anyone forge an IP.
TRUST_PROXY=0

# OPTIONAL. The URL guests should open, used for the QR code on the TV screen.
# Only needed if the TV cannot figure it out from its own address bar --
# e.g. you open the TV screen on a laptop but guests use a tunnel URL.
VOTE_URL=

NODE_ENV=production
